Database library for [URL="https://www.esoui.com/downloads/info1617-FurnitureCatalogue.html"]FurnitureCatalogue[/URL] (required).

[COLOR=red][SIZE=4]Database updates ship here, independent of FurnitureCatalogue releases.[/SIZE][/COLOR]

[COLOR=wheat][SIZE=6]Links[/SIZE][/COLOR]
[LIST]
[*][URL="https://wookiefriseur.github.io/LFC/"]Web interface: browse, lists, contribute[/URL]
[*][URL="https://github.com/wookiefriseur/LFC/blob/main/LibFurnitureCatalogue/Api.lua"]API reference[/URL]
[*][URL="https://github.com/wookiefriseur/LFC"]GitHub: source and issues[/URL]
[/LIST]

[COLOR=wheat][SIZE=6]Used by[/SIZE][/COLOR]
[LIST]
[*][URL="https://www.esoui.com/downloads/info1617-FurnitureCatalogue.html"]FurnitureCatalogue[/URL]
[*][URL="https://www.esoui.com/downloads/info1865-FurnitureShoppingListFurC2.0patch.html"]FurnitureShoppingList (FurC 2.0 patch)[/URL]
[/LIST]

[COLOR=wheat][SIZE=6]Chat commands[/SIZE][/COLOR]
[LIST]
[*][B]/lfc [I]id|link[/I][/B] -> sources and mats
[*][B]/lfc raw [I]id|link[/I][/B] -> raw record
[*][B]/lfc db[/B] -> library version, loading state, item count
[/LIST]

[COLOR=wheat][SIZE=6]API[/SIZE][/COLOR]

Manifest:
[code]## DependsOn: LibFurnitureCatalogue[/code]

[highlight="lua"]local LFC = LibFurnitureCatalogue.API

LFC.OnReady(function()
  local entry = LFC.GetEntry(203600)
  if entry then
    d(zo_strformat("<<C:1>>", GetItemLinkName(LFC.GetItemLink(entry.id))))
    d(#LFC.GetSourceDetails(entry.id) .. " sources")
  end
end)[/highlight]

[COLOR=wheat][SIZE=3]Queries[/SIZE][/COLOR]

[I]id[/I] = item ID or link. A recipe resolves to its furnishing.
[LIST]
[*][B]Has(id)[/B]: entry exists
[*][B]GetEntry(id)[/B]: id, sources (set), version, blueprint. A copy, safe to edit. nil on a miss
[*][B]GetSourceDetails(id)[/B]: one record per way to obtain it (vendor, locations, cost). Read-only, ZO_DeepTableCopy to edit
[*][B]GetIngredients(id)[/B]: ingredient link -> quantity
[*][B]GetItemIds()[/B], [B]GetEntryCount()[/B]
[/LIST]

[COLOR=wheat][SIZE=3]Source type[/SIZE][/COLOR]

[highlight="lua"]local entry = LFC.GetEntry(203600)
local sources = LFC.GetSourceTypes()
if entry and entry.sources[sources.PVP] then
  d("PvP source")
end[/highlight]

[COLOR=wheat][SIZE=3]Vendors, locations, prices[/SIZE][/COLOR]

[highlight="lua"]for _, record in ipairs(LFC.GetSourceDetails(203600)) do
  local source = record.source
  if source.vendor then
    d(zo_strformat("<<C:1>>", GetString(source.vendor)))
  end

  for _, placement in ipairs(source.locations or {}) do
    if placement.location then
      d(zo_strformat("<<C:1>>", GetZoneNameById(placement.location)))
    end
    if placement.place then
      d(zo_strformat("<<C:1>>", GetString(placement.place)))
    end
  end

  if record.cost then
    d(record.cost.amount .. " " .. GetCurrencyName(record.cost.currency, false, false))
  end
end[/highlight]

Records come in display order, not ranked.

[COLOR=wheat][SIZE=3]IDs to names[/SIZE][/COLOR]
[LIST]
[*]vendor, place, event: GetString
[*]location: GetZoneNameById
[*]achievement: GetAchievementInfo
[*]quest: GetQuestName
[*]crate: GetCrownCrateName
[*]houses (list of collectible IDs): GetCollectibleName
[*]item and ingredient links: GetItemLinkName
[/LIST]
nil = no value. 0 = known to exist, ID unknown: check > 0.

[COLOR=wheat][SIZE=3]Crafting materials[/SIZE][/COLOR]

[highlight="lua"]local materials = LFC.GetIngredients(118991) -- recipe: High Elf Stool, Curved
for ingredientLink, quantity in pairs(materials) do
  d(quantity .. "x " .. zo_strformat("<<C:1>>", GetItemLinkName(ingredientLink)))
end[/highlight]

[COLOR=wheat][SIZE=3]Loading[/SIZE][/COLOR]
[LIST]
[*][B]OnReady(fn)[/B]: loads if needed, runs fn once (at once if ready)
[*][B]IsReady()[/B]: check only. Results before ready may be incomplete
[*][B]GetState()[/B]: uninitialized, building, ready, failed
[*][B]RegisterCallback(event, fn)[/B]: LFC.Events.SCAN_STARTED, SCAN_COMPLETE, SCAN_FAILED. UnregisterCallback with the same arguments
[*][B]GetDBRevision()[/B]: changes when cached results are stale
[/LIST]

[COLOR=wheat][SIZE=3]Constants[/SIZE][/COLOR]
[LIST]
[*][B]GetSourceTypes()[/B]: source name -> ID
[*][B]GetSourceTypeInfo()[/B]: source ID -> stable key, English description
[*][B]GetDataVersions()[/B]: update name -> ID (entry.version)
[*][B]GetDataVersionKeys()[/B]: update ID -> name
[*][B]GetFurnitureCategories()[/B]: category ID -> localised name, parent, order
[/LIST]
Persist keys, not numeric IDs: those can change between releases.

[COLOR=wheat][SIZE=3]Old calls[/SIZE][/COLOR]
[LIST]
[*]FurC.Find -> LFC.GetEntry (miss: nil, not an empty table)
[*]FurC.GetItemId / FurC.GetItemLink -> LFC.GetItemId / LFC.GetItemLink
[*]FurC.GetIngredients / FurC.GetMats -> LFC.GetIngredients (unformatted quantities)
[*]GetSources -> GetSourceDetails (cost: one table or nil)
[*]SourceType -> GetSourceTypes, check entry.sources
[*]entry.origin -> first GetSourceDetails record
[*]record.source.location / place -> record.source.locations (list)
[*]record.availability -> entry.version (update), record.lastSeen (luxury date)
[/LIST]
