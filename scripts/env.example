# Copy to .env in the repo root and fill in the values you need
# Loaded by scripts/build.sh and tests/run_static.sh
# Values shown are the defaults, uncomment what you need to change

# python3 binary, if not on PATH
#PYTHON3_BIN=python3

# Directory the pinned StyLua binary is cached in
# scripts/stylua.sh downloads it there as stylua-<version>
#STYLUA_CACHE=$HOME/.cache/bins

# Get the token from your ESOUI account. ESOUI wants it on every API endpoint, so this is needed for build.sh --publish
#ESOUI_API_TOKEN=

# Lua binaries for tests/run_static.sh, full paths including the binary name
#LUAC=./bin/luac
#LUA=./bin/lua
